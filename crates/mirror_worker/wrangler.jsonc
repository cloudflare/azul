{
    "name": "mirror-worker",
    "main": "build/worker/shim.mjs",
    "compatibility_date": "2025-09-25",
    "workers_dev": false,
    "build": {
        "command": "echo 'Default environment not configured. Please specify an environment with the \"-e\" flag.' && exit 1"
    },
    "env": {
        "dev": {
            "build": {
                // DEPLOY_ENV is used in build.rs to select the per-environment
                // config. Change '--release' to '--dev' to compile with debug
                // symbols.
                // RUSTFLAGS: force legacy Wasm EH so wasm-bindgen 0.2.126's
                // wasmparser accepts the module (modern exnref opcodes from
                // nightly >=2026-05-09 are not yet supported).
                // --panic-unwind: build with panic=unwind so the sentry
                // catch-unwind guards in the fetch/alarm handlers can report
                // panics before the isolate is torn down.
                "command": "cargo install -q worker-build@0.8.5 && DEPLOY_ENV=dev RUSTFLAGS='-Cllvm-args=-wasm-use-legacy-eh' worker-build --release --panic-unwind"
            },
            "workers_dev": true,
            "triggers": {
                "crons": ["17 * * * *"]
            },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "MIRROR_STATE",
                        "class_name": "MirrorState"
                    },
                    // Per-origin partial-tile cleaner. Deletes a tile's
                    // partials from the public bucket once the full tile
                    // exists, on a periodic alarm; see
                    // `src/cleaner_do.rs`.
                    {
                        "name": "MIRROR_CLEANER",
                        "class_name": "MirrorCleaner"
                    },
                    {
                        "name": "COSIGNER_REGISTRY",
                        "class_name": "CosignerRegistry"
                    }
                ]
            },
            // Separate public buckets serve mirror tiles and witness
            // checkpoints. Each stores origins under `<origin hash>/`.
            "r2_buckets": [
                {
                    "bucket_name": "mirror-worker-public-dev",
                    "binding": "PUBLIC_BUCKET"
                },
                {
                    "bucket_name": "witness-worker-public-dev",
                    "binding": "WITNESS_BUCKET"
                }
            ],
            "version_metadata": {
                "binding": "VERSION_METADATA"
            },
            "migrations": [
                {
                    "tag": "v1",
                    "new_sqlite_classes": ["MirrorState", "MirrorCleaner"]
                },
                {
                    "tag": "v2",
                    "new_sqlite_classes": ["CosignerRegistry"]
                }
            ]
        },
        "witness": {
            "build": {
                "command": "cargo install -q worker-build@0.8.5 && DEPLOY_ENV=witness RUSTFLAGS='-Cllvm-args=-wasm-use-legacy-eh' worker-build --release --panic-unwind"
            },
            "workers_dev": true,
            "triggers": {
                "crons": ["17 * * * *"]
            },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "MIRROR_STATE",
                        "class_name": "MirrorState"
                    },
                    {
                        "name": "COSIGNER_REGISTRY",
                        "class_name": "CosignerRegistry"
                    }
                ]
            },
            "r2_buckets": [
                {
                    "bucket_name": "witness-worker-public-dev",
                    "binding": "WITNESS_BUCKET"
                }
            ],
            "version_metadata": {
                "binding": "VERSION_METADATA"
            },
            "migrations": [
                {
                    "tag": "v1",
                    "new_sqlite_classes": ["MirrorState"]
                },
                {
                    "tag": "v2",
                    "new_sqlite_classes": ["CosignerRegistry"]
                }
            ]
        },
        "mirror": {
            "build": {
                "command": "cargo install -q worker-build@0.8.5 && DEPLOY_ENV=mirror RUSTFLAGS='-Cllvm-args=-wasm-use-legacy-eh' worker-build --release --panic-unwind"
            },
            "workers_dev": true,
            "triggers": {
                "crons": ["17 * * * *"]
            },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "MIRROR_STATE",
                        "class_name": "MirrorState"
                    },
                    {
                        "name": "MIRROR_CLEANER",
                        "class_name": "MirrorCleaner"
                    },
                    {
                        "name": "COSIGNER_REGISTRY",
                        "class_name": "CosignerRegistry"
                    }
                ]
            },
            "r2_buckets": [
                {
                    "bucket_name": "mirror-worker-public-dev",
                    "binding": "PUBLIC_BUCKET"
                }
            ],
            "version_metadata": {
                "binding": "VERSION_METADATA"
            },
            "migrations": [
                {
                    "tag": "v1",
                    "new_sqlite_classes": ["MirrorState", "MirrorCleaner"]
                },
                {
                    "tag": "v2",
                    "new_sqlite_classes": ["CosignerRegistry"]
                }
            ]
        }
    }
}
